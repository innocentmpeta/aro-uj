rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Always publicly readable — structural/config data
    match /siteConfig/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /programmes/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Projects — fully readable by public (visitors need to read
    // unpublished drafts aren't shown because the app filters them,
    // but the Firestore rule must allow the collection read)
    match /projects/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // news — same pattern
    match /news/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // workPackages — overrides for a fixed set of 10 canonical work
    // packages (no draft/unpublished concept), so the frontend queries
    // this collection without a published filter. Must be publicly
    // readable unconditionally, or that unfiltered query is denied.
    match /workPackages/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // admins — CMS access-control list. A signed-in user may check only
    // their own admin status. Admin status is granted out-of-band
    // (Firestore console / CLI), never by a client write.
    //
    // NOTE: Firestore evaluates every matching `match` block with OR
    // logic — the catch-all below would still apply to admins/** and
    // grant any signed-in user read+write there unless explicitly
    // excluded, so its condition below carries a `collection != 'admins'`
    // guard rather than relying on this block alone.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // team, publications, resources — published only for public
    match /{collection}/{document=**} {
      allow read: if collection != 'admins' && resource.data.published == true;
      allow read, write: if collection != 'admins' && request.auth != null;
    }
  }
}
